    {
      "id": "st08iT7flSzi-D0TlOCsS",
      "type": "text",
      "x": 4763.000749564502,
      "y": -3051.4395117571166,
      "width": 1722.59912109375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#f783ac",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 1841250434,
      "version": 316,
      "versionNonce": 782051175,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795376311187,
      "link": null,
      "locked": false,
      "text": "comando 'insert' = INSERT INTO \"nome.tabela\" VALUES (valor1 = colunm1, valor2 = colonm2",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "comando 'insert' = INSERT INTO \"nome.tabela\" VALUES (valor1 = colunm1, valor2 = colonm2",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "z9nkhVU7GAQ-VrC0Wr66p",
      "type": "text",
      "x": 4762.334082897836,
      "y": -3009.272845090449,
      "width": 2653.19873046875,
      "height": 360,
      "angle": 0,
      "strokeColor": "#f783ac",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2H",
      "roundness": null,
      "seed": 741993822,
      "version": 1028,
      "versionNonce": 1924703881,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795376311187,
      "link": null,
      "locked": false,
      "text": "comando 'delete' = DELETE FROM \"nome.tabela\"\ncomando 'rollback' = ROLLBACK, volta ao ultimo 'savepoint'/ ROLLBACK TO SAVEPOINT \"name.point\"\ncomando 'savepoint' = SAVEPOINT name.point = salva os dados até aquele ponto\ncomando 'update' = UPDATE \"nome.tabela\" SET \"nome.coluna\" = new.valuer WHERE(onde) ID(o id) IN(é) (1,2)\ncomando 'begin' = BEGIN é o inicio de uma transação onde não é automaticamente commitado os dados NÃO PODE ESQUECER O BEGIN!\ncomando 'select' = para consultas, SELECT * FROM \"nome.tabela\" o asterisco quer dizer todos os dados da tabela \"nome.tabela\"\ncomando 'select' = para consultar apenas dados que queremos usamos, SELECT nome.coluna1, nome.coluna2, nome.coluna3 FROM \"nome.tabela\"\ncomando 'concatenar' = para concatenar colunas usamos, SELECT nome.coluna || nome.coluna2 FROM nome.tabela",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "comando 'delete' = DELETE FROM \"nome.tabela\"\ncomando 'rollback' = ROLLBACK, volta ao ultimo 'savepoint'/ ROLLBACK TO SAVEPOINT \"name.point\"\ncomando 'savepoint' = SAVEPOINT name.point = salva os dados até aquele ponto\ncomando 'update' = UPDATE \"nome.tabela\" SET \"nome.coluna\" = new.valuer WHERE(onde) ID(o id) IN(é) (1,2)\ncomando 'begin' = BEGIN é o inicio de uma transação onde não é automaticamente commitado os dados NÃO PODE ESQUECER O BEGIN!\ncomando 'select' = para consultas, SELECT * FROM \"nome.tabela\" o asterisco quer dizer todos os dados da tabela \"nome.tabela\"\ncomando 'select' = para consultar apenas dados que queremos usamos, SELECT nome.coluna1, nome.coluna2, nome.coluna3 FROM \"nome.tabela\"\ncomando 'concatenar' = para concatenar colunas usamos, SELECT nome.coluna || nome.coluna2 FROM nome.tabela",
      "autoResize": true,
      "lineHeight": 1.25
    },
